# ── Next.js (.env.local) ───────────────────────────────────────────────
# Written by `npx convex dev`:
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tools
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/tools

# Must match APP_TIME_ZONE on the Convex deployment
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Jakarta

# ── Convex deployment env (NOT in this file — set with `npx convex env set`) ──
# CLERK_JWT_ISSUER_DOMAIN   https://<your-app>.clerk.accounts.dev
# APP_TIME_ZONE             Asia/Jakarta
# N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop/request-events
# N8N_WEBHOOK_SECRET        <openssl rand -hex 32>   (Convex → n8n signing)
# CONVEX_INBOUND_SECRET     <openssl rand -hex 32>   (n8n → Convex signing)
# N8N_EDITOR_BASE_URL       http://localhost:5678    (optional, for "Open execution in n8n" links)
