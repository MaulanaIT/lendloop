# Non-secret defaults for the n8n containers. Override any of them in n8n/.env
# (loaded after this file, so its values win). Secrets never go in this file.

# Schedule Trigger + reminder runDate use this zone. Keep it equal to
# APP_TIME_ZONE on the Convex deployment so "overdue" means the same day on both sides.
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# Convex HTTP actions (local `npx convex dev` serves them on :3211).
CONVEX_SITE_URL=http://host.docker.internal:3211

# Used for the "Open in LendLoop" link in emails.
APP_URL=http://localhost:3000

MAIL_FROM=LendLoop <no-reply@lendloop.local>
