# n8n secrets and overrides for docker-compose.yml.
#   cp n8n/.env.example n8n/.env      (or: sh scripts/setup-n8n-env.sh, which fills in random values)
# n8n/.env is gitignored. Never commit real values.

# Encrypts credentials stored in the n8n database. Generate once and keep it:
# changing it later makes stored credentials unreadable.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me

# Convex → n8n: Convex signs request-event webhooks with this secret, n8n verifies.
# Must equal N8N_WEBHOOK_SECRET in the Convex deployment env.
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-me

# n8n → Convex: n8n signs write-backs and the overdue-loans fetch, Convex verifies.
# Must equal CONVEX_INBOUND_SECRET in the Convex deployment env.
#   openssl rand -hex 32
CONVEX_INBOUND_SECRET=replace-me

# ── Optional overrides (defaults live in n8n/defaults.env) ──────────────────
# GENERIC_TIMEZONE=Asia/Jakarta
# TZ=Asia/Jakarta
# CONVEX_SITE_URL=http://host.docker.internal:3211
# APP_URL=http://localhost:3000
# MAIL_FROM=LendLoop <no-reply@lendloop.local>
